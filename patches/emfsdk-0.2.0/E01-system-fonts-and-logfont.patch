+/// 兜底顺序：通用无衬线打头（EMF 的默认），后面按用到的脚本补常见系统字族。
+const FALLBACK_FAMILIES: &[fontdb::Family<'static>] = &[
+  fontdb::Family::SansSerif,
+  fontdb::Family::Name("Microsoft YaHei"),
+  fontdb::Family::Name("SimSun"),
+  fontdb::Family::Name("Noto Sans CJK SC"),
+  fontdb::Family::Name("PingFang SC"),
+  fontdb::Family::Name("Microsoft JhengHei"),
+  fontdb::Family::Name("Malgun Gothic"),
+  fontdb::Family::Name("Segoe UI"),
+];
+
+/// 进程内只索引一次：`load_system_fonts` 在本机 400 面要扫 260–950 ms，
+/// 而字库数据走 mmap 共享，不复制进堆（单个中日韩字库 10–20 MB）。
+static SYSTEM_FACES: std::sync::OnceLock<std::sync::Arc<Vec<FontFace>>> = std::sync::OnceLock::new();
+
+// 唯一的 unsafe：把系统字库映射成可长期持有的只读共享数据（与宿主 usvg 侧的
+// 字库读取同一种做法）。换掉的是上游"复制一份进堆、每次渲染再复制一份"。
+#[allow(unsafe_code)]
+fn system_faces() -> std::sync::Arc<Vec<FontFace>> {
+  SYSTEM_FACES
+    .get_or_init(|| {
+      let mut db = fontdb::Database::new();
+      db.load_system_fonts();
+      let mut faces = Vec::new();
+      let mut seen = Vec::new();
+      for family in FALLBACK_FAMILIES {
+        let query = fontdb::Query {
+          families: std::slice::from_ref(family),
+          ..fontdb::Query::default()
+        };
+        let Some(id) = db.query(&query) else {
+          continue;
+        };
+        if seen.contains(&id) {
+          continue;
+        }
+        seen.push(id);
+        let name = match family {
+          fontdb::Family::Name(name) => (*name).to_owned(),
+          _ => String::new(),
+        };
+        let source = db.face(id).map(|face| face.source.clone());
+        let index = db.face(id).map(|face| face.index).unwrap_or(0);
+        let data = match source {
+          Some(fontdb::Source::Binary(data)) => data,
+          // SAFETY: 只读映射；系统字库在渲染期间被替换的概率与其它解码器读字库一致。
+          _ => match unsafe { db.make_shared_face_data(id) } {
+            Some((data, _)) => data,
+            None => continue,
+          },
+        };
+        faces.push(FontFace {
+          family: name,
+          data,
+          index,
+        });
+      }
+      std::sync::Arc::new(faces)
+    })
+    .clone()
+}
