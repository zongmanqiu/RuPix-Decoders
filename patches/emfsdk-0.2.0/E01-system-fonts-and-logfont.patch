+/// LOGFONTW 的 `lfFaceName` 是 32 个 UTF-16 码元、NUL 结尾的定长块。
+fn read_logfont_face_name(data: &[u8], offset: usize) -> Option<String> {
+  let bytes = data.get(offset..offset + LOGFONT_FACE_NAME_CHARS * 2)?;
+  let units: Vec<u16> = bytes
+    .chunks_exact(2)
+    .map(|pair| u16::from_le_bytes([pair[0], pair[1]]))
+    .take_while(|unit| *unit != 0)
+    .collect();
+  Some(String::from_utf16_lossy(&units).trim().to_owned())
 }
 
