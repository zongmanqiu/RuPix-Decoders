+/// 把线段裁到矩形内（Liang–Barsky）。整段在矩形外返回 `None`。
+///
+/// 只服务描边：EMF 里的坐标是外部数据，动辄出现六位数；不裁剪的话 Bresenham 会
+/// 老老实实一步步走完（一条 63 万像素的线，配上错误的笔宽就是几十分钟）。
+fn clip_segment(
+  (x0, y0): (f32, f32),
+  (x1, y1): (f32, f32),
+  (left, top): (f32, f32),
+  (right, bottom): (f32, f32),
+) -> Option<((f32, f32), (f32, f32))> {
+  if !x0.is_finite() || !y0.is_finite() || !x1.is_finite() || !y1.is_finite() {
+    return None;
+  }
+  let (dx, dy) = (x1 - x0, y1 - y0);
+  let mut t0 = 0.0f32;
+  let mut t1 = 1.0f32;
+  // 每条边界一个 (分母, 分子)：t < 0 是进入点，t > 0 是离开点。
+  for (p, q) in [
+    (-dx, x0 - left),
+    (dx, right - x0),
+    (-dy, y0 - top),
+    (dy, bottom - y0),
+  ] {
+    if p == 0.0 {
+      // 与该边平行：在边界外就整段不可见。
+      if q < 0.0 {
+        return None;
+      }
+      continue;
+    }
+    let t = q / p;
+    if p < 0.0 {
+      if t > t1 {
+        return None;
+      }
+      if t > t0 {
+        t0 = t;
+      }
+    } else {
+      if t < t0 {
+        return None;
+      }
+      if t < t1 {
+        t1 = t;
+      }
+    }
+  }
+  Some((
+    (x0 + dx * t0, y0 + dy * t0),
+    (x0 + dx * t1, y0 + dy * t1),
+  ))
+}
