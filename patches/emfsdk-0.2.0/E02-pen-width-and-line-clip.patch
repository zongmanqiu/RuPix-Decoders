+  /// 画笔宽度是**世界坐标**单位，必须乘上与点同一个 world/viewport 变换才落到像素。
+  ///
+  /// 上游把 `EmfPen::width` 直接当像素半径用。缩放比极小的文档（EMF+ 常见，
+  /// 本机实测 0.00018）里，一条 12700 单位的笔宽就变成 12700 像素半径：一次描边要刷
+  /// 1.6 亿像素 × 上百个点，表现为「这张图一打开就永远出不来」（2026-11-04 实测
+  /// `图片2.emf` 卡死 15 分钟以上，且把整个单线程解码队列堵死，后续换图全部无响应）。
+  fn device_pen_width(&self, width: usize) -> usize {
+    if width <= 1 {
+      return 1;
+    }
+    // 夹一个上限再进 `i32`：笔宽字段是外部数据，溢出会让下面这条映射变成 UB 级噪音。
+    let w = width.min(1_000_000) as i32;
+    let (x0, _) = self.map_point(EmfPoint { x: 0, y: 0 });
+    let (x1, _) = self.map_point(EmfPoint { x: w, y: 0 });
+    let px = (x1 - x0).abs();
+    if !px.is_finite() {
+      return 1;
+    }
+    // 再夹到画布尺寸：半径超过画布的那部分本来就一个像素也落不下。
+    let cap = self.width.max(self.height).max(1);
+    (px.round() as usize).clamp(1, cap)
+  }
